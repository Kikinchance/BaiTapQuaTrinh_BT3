<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Nút Back hiện đại -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBack"
            android:src="@drawable/ic_arrow_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:tint="#FFFFFF"
            android:scaleType="centerInside"/>


        <!-- Title của màn hình này (có thể để trống nếu không cần) -->
        <TextView
            android:text="Điều khiển đèn"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- MAIN CONTENT CARD -->
    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:padding="32dp"
        android:background="@drawable/bg_card"
        android:elevation="12dp"
        app:cardCornerRadius="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- Status -->
    <TextView
        android:id="@+id/txtStatus"
        android:text="🌙 ĐÈN ĐANG TẮT"
        android:textColor="#333333"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Hướng dẫn -->
    <TextView
        android:text="Vẫy tay gần cảm biến để bật/tắt đèn"
        android:textColor="#555555"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Thêm icon minh họa (tùy chọn - rất đẹp) -->
    <TextView
        android:text="👋"
        android:textSize="80sp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>

    <!-- Spacer để đẩy nội dung lên giữa màn hình một chút -->
<View
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1"/>

    </LinearLayout>